{
  "name": "ai-whatsnew",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @ai-whatsnew/db --",
    "db:studio": "turbo run db:studio -F @ai-whatsnew/db --",
    "db:generate": "turbo run db:generate -F @ai-whatsnew/db --",
    "db:migrate": "turbo run db:migrate -F @ai-whatsnew/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && pnpm run auth:generate",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-whatsnew/config": "workspace:*",
    "@biomejs/biome": "2.5.12",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@12.8.1"
}
